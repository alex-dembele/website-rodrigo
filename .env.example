# Variables à définir sur l'hébergeur (Vercel → Settings → Environment Variables).
# Copier ce fichier en .env.local pour travailler en local.

# --- Espace de gestion (/admin) ---
# Mot de passe unique donné au gérant. Sans cette variable, l'espace de gestion
# affiche « pas encore activé » et refuse toute connexion.
ADMIN_PASSWORD=

# --- Enregistrement des modifications ---
# Jeton GitHub « fine-grained » limité à CE dépôt, avec la permission
# « Contents: Read and write ». C'est lui qui permet d'enregistrer les
# modifications faites depuis l'espace de gestion.
GITHUB_TOKEN=
# Dépôt visé, au format proprietaire/depot
GITHUB_REPO=alex-dembele/website-rodrigo
# Branche mise à jour par l'espace de gestion (celle que l'hébergeur publie)
GITHUB_BRANCH=main
